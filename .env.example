# --- App security -----------------------------------------------------------
# Signs session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# HTTP Basic auth for the whole app (incl. your resume). Strongly recommended
# if the port is ever exposed beyond localhost. Leave APP_PASSWORD blank to disable.
APP_USERNAME=admin
APP_PASSWORD=
# Set to 1 only when served over HTTPS
SESSION_COOKIE_SECURE=0
LOG_LEVEL=INFO

# keys to access data to compare wages between cities
# <https://api-ninjas.com/>
API_NINJAS_KEY=your_api_ninjas_key_here
# <https://openei.org/services/>
OPENEI_API_KEY=openei_api_key_here
# <https://www.eia.gov/opendata/register.php>
EIA_API_KEY=eia_api_key_here
# <https://www.huduser.gov/portal/dataset/fmr-api.html>
HUD_FMR_API_TOKEN=hud_personal_access_token_here
#<https://apps.bea.gov/api/signup/>
BEA_API_KEY=bea_api_key_here
